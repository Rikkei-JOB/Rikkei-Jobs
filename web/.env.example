# Sao chép thành .env.local rồi chỉnh theo máy của bạn (.env.local không được commit).

# Gateway: mọi API nằm dưới /api/v1 (docs/conventions.md), ví dụ /api/v1/auth/login.
# Chạy riêng identity-service, không qua gateway: http://localhost:8081 (không có tiền tố /api/v1).
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Trang đăng nhập của LMS thật. LMS đăng nhập xong phải chuyển về
# <địa chỉ web>/sso-callback?ticket=<vé>. Để trống nếu chưa có LMS thật.
NEXT_PUBLIC_LMS_LOGIN_URL=

# Chỉ dùng khi phát triển/demo: hiện 6 người dùng LMS mẫu ở tab "Qua LMS". Bấm vào một người thì frontend
# nhờ backend (POST /auth/dev/sso-ticket) cấp vé qua mock tại mock/ (cổng 9000). Frontend không gọi thẳng mock
# vì khoá dịch vụ chỉ nằm ở backend. identity-service phải chạy với profile dev (mặc định endpoint này tắt).
NEXT_PUBLIC_LMS_MOCK=true

# Bật trang Việc làm với JD mock khi chạy local.
# NEXT_PUBLIC_JOB_API_PATH=http://localhost:9000/jobs
# NEXT_PUBLIC_JOB_PAGE_PATH=/candidate/jobs
