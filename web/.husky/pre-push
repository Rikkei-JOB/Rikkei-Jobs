while read -r local_ref local_oid remote_ref remote_oid; do
  [ "$local_ref" = "(delete)" ] && continue

  case "$remote_ref" in
    refs/heads/main|refs/heads/test) continue ;;
    refs/heads/*) branch=${remote_ref#refs/heads/} ;;
    *) continue ;;
  esac

  sh scripts/check-feature-branch.sh "$branch" || exit 1
done
