# ==============================================================
# Rikkei Jobs - Environment Configuration Example
# ==============================================================

# Database Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rikkei_jobs

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# JWT Secrets & Security
JWT_SECRET=your_super_secret_jwt_key_at_least_256_bits_long_rikkei_jobs
JWT_EXPIRATION_MS=28800000
REFRESH_TOKEN_EXPIRATION_MS=604800000

# Identity service (NT-01)
WEB_BASE_URL=http://localhost:3000
# External LMS = mock/ (npm start, port 9000). Backend sends X-Service-Key; never expose it to the frontend.
LMS_BASE_URL=http://localhost:9000
LMS_SERVICE_KEY=dev-key
# Dev-only features below are OFF in application.yml. They are turned on by the "dev" Spring profile
# (SPRING_PROFILES_ACTIVE=dev, or mvn ... spring-boot:run -Dspring-boot.run.profiles=dev).
# Never use the dev profile on a shared or production environment.
SPRING_PROFILES_ACTIVE=dev
LMS_DEV_TICKETS_ENABLED=true           # POST /auth/dev/sso-ticket: issues a ticket for ANY lmsUserId without auth
DEV_DATA_ENABLED=true                  # seeds the sample accounts (@rikkeijobs.test, known password Test@123)
# HS-01 sample sources: also requires Spring profile dev and NT-01 accounts in the same database.
PROFILE_DEMO_DATA_ENABLED=false
MAIL_ENABLED=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@rikkei-jobs.local

# Company service (DN-01)
# Khoá nội bộ company-service gửi (header X-Internal-Key) khi gọi API /internal/** của identity-service. Hai bên phải trùng nhau.
INTERNAL_SERVICE_KEY=dev-internal-key
# Địa chỉ identity-service mà company-service (và gateway) gọi tới.
IDENTITY_SERVICE_URL=http://localhost:8081
# Thư mục lưu logo công ty tải lên (đã được .gitignore bỏ qua).
COMPANY_UPLOAD_DIR=./data/uploads
# Schema Postgres riêng của company-service.
COMPANY_DB_SCHEMA=company

# Service Ports
GATEWAY_PORT=8080
IDENTITY_SERVICE_PORT=8081
PROFILE_SERVICE_PORT=8082
COMPANY_SERVICE_PORT=8085
INTERNSHIP_SERVICE_PORT=8086
ASSESSMENT_SERVICE_PORT=8087
LEARNING_SERVICE_PORT=8084
RECRUITMENT_SERVICE_PORT=8083
RECRUITMENT_CV_STORAGE_DIR=.runtime/recruitment-cvs
RECRUITMENT_OUTBOX_ENABLED=true
# Consumer contracts: align with DN-04 / HS-04 before enabling apply in production.
COMPANY_SERVICE_URL=http://localhost:8085
PROFILE_SERVICE_URL=http://localhost:8082
# Optional override; otherwise reuse INTERNAL_SERVICE_KEY from the internal API settings above.
# RECRUITMENT_COMPANY_SERVICE_KEY=
RECRUITMENT_JOB_CONTEXT_PATH=/internal/jobs/{jobId}/application-context
RECRUITMENT_CV_PDF_PATH=/profile/cvs/{cvId}/pdf
AI_SERVICE_PORT=8088

# Optional per-service datasource URLs (otherwise use POSTGRES_* above)
# IDENTITY_DB_URL=jdbc:postgresql://localhost:5432/rikkei_jobs_identity
# PROFILE_DB_URL=jdbc:postgresql://localhost:5432/rikkei_jobs_profile
# COMPANY_DB_URL=jdbc:postgresql://localhost:5432/rikkei_jobs_company
# INTERNSHIP_DB_URL=jdbc:postgresql://localhost:5432/rikkei_jobs_internship
# ASSESSMENT_DB_URL=jdbc:postgresql://localhost:5432/rikkei_jobs_assessment
# LEARNING_DB_URL=jdbc:postgresql://localhost:5432/rikkei_jobs_learning
# RECRUITMENT_DB_URL=jdbc:postgresql://localhost:5432/rikkei_jobs_recruitment
# Each JPA service also supports <NAME>_DB_USER and <NAME>_DB_PASSWORD.

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_CV_API_PATH=/profile/cvs
NEXT_PUBLIC_CV_PAGE_PATH=/candidate/cvs
NEXT_PUBLIC_JOB_PAGE_PATH=/jobs

# Monitoring
GRAFANA_PASSWORD=admin
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
