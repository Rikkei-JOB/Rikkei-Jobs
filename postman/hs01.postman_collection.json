{
  "info": {
    "name": "Rikkei Jobs · HS-01 backend integration",
    "description": "Run the entire collection in order against an isolated dev database after identity dev seed and PROFILE_DEMO_DATA_ENABLED=true profile seed. Uses /auth/dev/sso-ticket then /auth/sso to obtain real candidate UUIDs. Candidate profiles stay private. Requests read profiles and recompute only from stored source; there is no HTTP evidence import or publication mutation. Tokens are held in run variables. Demo data is dated 2026-09/10; score assertions use the documented 2026-11 fixture baseline.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
