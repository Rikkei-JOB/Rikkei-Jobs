  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const path = pm.request.url.toString();",
          "if (path.includes(\"/profiles/\") && pm.response.code === 200) {",
          "    const skills = pm.response.json();",
          "    pm.test(\"Returns a bare skills array with source, score and dated evidence\", function () {",
          "        pm.expect(skills).to.be.an(\"array\");",
          "        skills.forEach(function (row) {",
          "            pm.expect(row.skill.id).to.match(/^[0-9a-f-]{36}$/i);",
          "            [\"code\", \"name\", \"group\"].forEach(function (key) { pm.expect(row.skill[key]).to.be.a(\"string\"); });",
          "            [\"verifiedScore\", \"selfScore\"].forEach(function (key) {",
          "                if (row[key] !== null) { pm.expect(row[key]).to.be.within(0, 100); }",
          "            });",
          "            pm.expect(row.level).to.be.oneOf([null, \"BASIC\", \"FAIR\", \"GOOD\", \"EXCELLENT\"]);",
          "            pm.expect(row.evidences).to.be.an(\"array\");",
          "            row.evidences.forEach(function (evidence) {",
          "                pm.expect(evidence.source).to.be.oneOf([\"LMS\", \"EXAM\", \"INTERNSHIP\", \"MENTOR\", \"SELF\"]);",
          "                pm.expect(evidence.title).to.be.a(\"string\").and.not.empty;",
          "                pm.expect(evidence.score).to.be.within(0, 100);",
          "                pm.expect(evidence.verified).to.be.a(\"boolean\");",
          "                pm.expect(evidence.recordedAt).to.match(/(Z|[+-]\\d{2}:\\d{2})$/);",
          "                pm.expect(Number.isFinite(Date.parse(evidence.recordedAt))).to.equal(true);",
          "                if (evidence.source === \"SELF\") { pm.expect(evidence.verified).to.equal(false); }",
          "            });",
          "            if (row.verifiedScore === null) { pm.expect(row.level).to.equal(null); }",
          "        });",
          "    });",
          "}",
          "if (pm.response.code >= 400) {",
          "    pm.test(\"Errors retain the common code/message shape\", function () {",
          "        const error = pm.response.json();",
          "        pm.expect(error.code).to.be.a(\"string\");",
          "        pm.expect(error.message).to.be.a(\"string\");",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1 · Request candidate1 SSO ticket",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/dev/sso-ticket",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"lmsUserId\":\"lms-sv-001\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Dev ticket issued\", function () { pm.response.to.have.status(200); pm.expect(pm.response.json().ticket).to.be.a(\"string\").and.not.empty; });",
              "pm.collectionVariables.set(\"candidate1Ticket\", pm.response.json().ticket);"
            ]
          }
        }
      ]
    },
    {
      "name": "1 · Exchange ticket for candidate1 JWT and real UUID",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/sso",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\"ticket\":\"{{candidate1Ticket}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"SSO returns candidate identity\", function () { pm.response.to.have.status(200); pm.expect(pm.response.json().user.role).to.equal(\"CANDIDATE\"); });",
              "const data = pm.response.json();",
              "pm.collectionVariables.set(\"candidate1Token\", data.accessToken);",
              "pm.collectionVariables.set(\"candidate1Id\", data.user.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Candidate1 · Read own verified and SELF-only skills",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{candidate1Token}}"
          }
        ],
        "url": "{{baseUrl}}/profiles/me/skills",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.response.to.have.status(200);",
              "const skills = pm.response.json();",
              "pm.test(\"Candidate1 has eight verified skills plus SELF-only English\", function () {",
              "    pm.expect(skills.length).to.equal(9);",
              "    pm.expect(skills.filter(function (s) { return s.verifiedScore !== null; }).length).to.equal(8);",
              "    const english = skills.find(function (s) { return s.skill.code === \"ENGLISH\"; });",
              "    pm.expect(english.verifiedScore).to.equal(null);",
              "    pm.expect(english.level).to.equal(null);",
              "    pm.expect(english.selfScore).to.equal(Number(pm.collectionVariables.get(\"englishSelfScore\")));",
              "    pm.expect(english.evidences.every(function (e) { return e.source === \"SELF\" && !e.verified; })).to.equal(true);",
              "});",
              "pm.test(\"Java retains normalized scores and original source dates\", function () {",
              "    const java = skills.find(function (s) { return s.skill.code === \"JAVA\"; });",
              "    pm.expect(java.verifiedScore).to.be.closeTo(82.058824, 0.000001);",
              "    pm.expect(java.level).to.equal(\"GOOD\");",
              "    const exam = java.evidences.find(function (e) { return e.source === \"EXAM\"; });",
              "    pm.expect(exam.score).to.equal(80);",
              "    pm.expect(new Date(exam.recordedAt).toISOString()).to.equal(\"2026-10-20T01:00:00.000Z\");",
              "    const sources = skills.flatMap(function (s) { return s.evidences.map(function (e) { return e.source; }); });",
              "    [\"LMS\", \"EXAM\", \"INTERNSHIP\", \"SELF\"].forEach(function (source) { pm.expect(sources).to.include(source); });",
              "});",
              "pm.collectionVariables.set(\"candidate1Skills\", JSON.stringify(skills));"
            ]
          }
        }
      ]
    },
